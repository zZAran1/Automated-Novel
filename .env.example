# 复制本文件为 .env 并填入你的真实 API Key
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填入你的APIKey

# 可选：默认使用 deepseek-chat（V3），推理任务可改为 deepseek-reasoner（R1）
DEEPSEEK_OUTLINE_MODEL=deepseek-reasoner
DEEPSEEK_TEXT_MODEL=deepseek-chat

# 可选：设置后访问业务接口需携带 Authorization: Bearer <token>（公网部署建议开启）
# 访问页面时在链接后携带 ?token=你的APP_TOKEN 即可正常使用
# APP_TOKEN=
